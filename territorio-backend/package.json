{
  "name": "corrientes-territorial-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute corrientes-territorial --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute corrientes-territorial --remote --file=schema.sql",
    "check": "node --check src/index.js"
  },
  "devDependencies": {
    "wrangler": "^4.26.1"
  }
}
